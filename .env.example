# Environment Configuration
APP_NAME="House Price Prediction DataOps & API Platform"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=true

# Dataset Configuration
DATA_SOURCE="Kaggle HouseData (shree1992/housedata)"

# Pipeline & Scheduler Configuration
SCHEDULER_INTERVAL_SECONDS=120
AUTO_START_SCHEDULER=true

# Data-quality simulation (blanks 2% of numeric cells so the missing-value
# imputation step is genuinely exercised). Set to 0.0 to disable.
SIMULATE_MISSING_PCT=0.02

# AWS / CloudWatch (leave CLOUDWATCH_ENABLED=false when running on a laptop)
AWS_REGION="us-east-1"
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP="/dataops/pipeline"
